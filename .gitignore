# Dependencies
node_modules/

# Secrets — never commit (.env.example placeholders stay tracked)
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Uploaded product images
uploads/
backend/uploads/

# Local database backups (may contain real data)
backups/
backend/backups/

# Logs, crash dumps & OS noise
*.log
*.tmp
*.dmp
*.stackdump
Thumbs.db
.DS_Store
desktop.ini

# Acceptance-run artifacts (screenshots / per-run report); the recorded report is tracked
docs/acceptance/out/

# Editor
.vscode/

# Vercel CLI local metadata (created by `vercel link`; machine-specific)
.vercel/
