# ===== Copy this file to ".env" and fill in real values =====
# Never commit the real .env to git!

PORT=5000

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# MySQL settings
MYSQL_HOST=localhost
MYSQL_DB=buyoDB
MYSQL_USER=root
MYSQL_PASS=your-mysql-password

# Optional: MySQL port (default 3306) and SSL for hosted databases (MYSQL_SSL=true)
# MYSQL_PORT=3306
# MYSQL_SSL=false
# TLS certificate verification is ON by default. Only for local development with
# a self-signed certificate, disable it explicitly (NEVER in production — it
# makes the connection vulnerable to man-in-the-middle attacks):
# MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Reverse-proxy trust (Phase 11). Leave UNSET when the app is served directly
# (local dev, or a platform that connects to your app directly). Set it ONLY
# when a real reverse proxy / load balancer fronts the app — otherwise every
# user shares the proxy's IP for rate limiting. Accepted values: a hop count
# (e.g. 1), "loopback", "uniquelocal", or explicit IPs/CIDRs (comma-separated).
# Trust-all (true) is refused by the server at startup.
# TRUST_PROXY=1

# Safety allowlist for scripts/db-sync.js — comma-separated LOCAL dev database names.
# The script also refuses: non-loopback hosts, NODE_ENV=production, and missing --confirm-local.
# Default allowlist (no need to set): buyoDB, buyoDB_ph1_verify
# DB_SYNC_ALLOWED_DATABASES=buyoDB

# Phase 3 tooling allowlists (all local-only; all also refuse non-loopback hosts,
# NODE_ENV=production and a missing --confirm-local flag):
# DB_MIGRATE_ALLOWED_DATABASES=buyoDB            # db:migrate target(s), default: buyoDB
# DB_ADMIN_ALLOWED_DATABASES=buyoDB              # admin:role target(s), default: buyoDB
# DB_RESTORE_ALLOWED_DATABASES=                  # extra db:restore targets;
#                                                # scratch names matching buyoDB_* work by default

# Hosted MySQL fallbacks — used automatically when the MYSQL_* names above are absent:
# MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD (Railway/Render-style names)

# ===== Migration Phase 1: dual-dialect (MySQL default, PostgreSQL opt-in) =====
# Dialect selection. UNSET (or "mysql") = the current MySQL behavior — the
# default and the production setting. "postgres" enables the LOCAL PostgreSQL
# migration harness only. Anything else refuses to start.
# DB_DIALECT=mysql

# Local PostgreSQL settings — read ONLY when DB_DIALECT=postgres. Loopback only.
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=buyoDB
# PG_USER=postgres
# PG_PASS=your-postgres-password

# ===== Phase 9: PostgreSQL production runtime (applies when DB_DIALECT=postgres) =====
# TLS for hosted PostgreSQL. UNSET = automatic: TLS with certificate VERIFICATION
# for non-loopback hosts, plaintext for loopback (local dev + embedded test
# clusters keep working with zero changes). "true"/"false" force either mode.
# There is intentionally NO switch to disable certificate verification.
# Connect by hostname (not a raw IP) so certificate hostnames match.
# PG_SSL=true

# Small serverless-suitable Sequelize pool (postgres path only; MySQL keeps its
# defaults). Invalid values refuse to start. Defaults shown.
# DB_POOL_MAX=2            # 1..10
# DB_POOL_MIN=0            # 0..DB_POOL_MAX
# DB_POOL_IDLE_MS=10000    # 1000..300000
# DB_POOL_ACQUIRE_MS=30000 # 1000..300000

# GET /api/health/ready bounded database probe timeout in ms (100..30000)
# HEALTH_DB_TIMEOUT_MS=2000

# ===== Phase 10: remote approval gate (per approved operation; unset = disabled) =====
# The PostgreSQL CLI tools (db:migrate, admin:role, db:backup, db-restore)
# evaluate ALL of the following before ANY non-loopback connection; without
# every condition they refuse first. Set only for an explicitly approved
# remote run, REMOVE afterwards. Never commit real values.
# PG_REMOTE_MIGRATION_APPROVED=phase-cutover-approval   # exact token
# PG_REMOTE_ALLOWED_HOSTS=db.<project-ref>.supabase.co:5432
# PG_REMOTE_ALLOWED_DATABASES=buyo_sandbox
# Plus the explicit --confirm-remote flag and NODE_ENV != production.

# DATABASE_URL is read ONLY when DB_DIALECT=postgres (approved Supabase phase),
# and only to fill connection fields the explicit PG_* names leave unset —
# those names always win, so a leftover URL here never retargets local runs.
# The remote-gate tripwire is UNCHANGED: a non-empty DATABASE_URL (here or in
# the environment) still TRIPS the gate — remove/rename this line before any
# approved remote run. Never commit real values.

# Email SMTP settings (Gmail: use a 16-character App Password, NOT your login password)
EMAIL_USER=yourmail@gmail.com
EMAIL_PASS=your-app-password

# Mail transport (test-only — leave UNSET in production):
#   MAIL_TRANSPORT=json   capture every message into an in-memory outbox (no SMTP, no
#                         credentials needed — use this to verify email links end-to-end)
#   MAIL_TRANSPORT=fail   force every send to fail (exercises the signup rollback; test env only)
# MAIL_TRANSPORT=json

# URLs used in email verification links / redirects (no trailing slash)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://127.0.0.1:5503

# ===== Phase 2 + Phase 3: security =====
# Admin provisioning: the DB `Users.role` column is the ONLY source of truth
# (grant via: npm run admin:role -- --email you@example.com --role admin --confirm-local).
# The transitional ADMIN_EMAILS env fallback was REMOVED in Phase 11 — setting
# that variable has no effect. See docs/admin-provisioning.md.

# Extra CORS origins (comma-separated). Local dev origins (5503/5500) and the
# origin of FRONTEND_URL are always allowed automatically.
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Rate limiting (optional overrides; defaults shown)
# RATE_LIMIT_GLOBAL_WINDOW_MS=900000
# RATE_LIMIT_GLOBAL_MAX=300
# RATE_LIMIT_AUTH_WINDOW_MS=900000
# RATE_LIMIT_AUTH_MAX=15

# Password-reset link lifetime (jsonwebtoken ms string; default 30m)
# RESET_TOKEN_TTL=30m

# ===== Phase 12: product-image storage =====
# Driver selection. UNSET = "local" (existing /uploads disk behavior — the dev
# default). Hosted environments (VERCEL set, or NODE_ENV=production) REFUSE to
# run without an explicit value here — there is no silent fallback to ephemeral
# disk. "supabase" requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY and uses
# the direct-to-storage upload flow (POST /api/uploads/authorize).
# STORAGE_DRIVER=local
# SUPABASE_URL=https://<project-ref>.supabase.co     # required with supabase
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key    # SERVER-SIDE ONLY, never in frontend code
# SUPABASE_STORAGE_BUCKET=product-images             # default shown
# MAX_IMAGE_BYTES=5242880                            # default 5 MB, clamp 1 KB..25 MB
# UPLOAD_AUTH_TTL_MS=600000                          # default 10 min, clamp 1 s..1 h

# Storage migration tool (scripts/storage-migrate.js) — refuses to run unless
# confirmed local; --apply additionally requires ALL of: the approval token
# below, --confirm-remote, an explicit --bucket, SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY, NODE_ENV != production and DATABASE_URL unset.
# STORAGE_MIGRATION_APPROVED=phase-cutover-approval  # exact token; remove after
# STORAGE_MIGRATE_ALLOWED_DATABASES=buyoDB_ph12_storage  # default shown; add buyoDB for a real dry-run
