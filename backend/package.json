{
  "name": "buyo-backend",
  "version": "1.0.0",
  "description": "Backend API for BuyO e-commerce project",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:sync": "node scripts/db-sync.js",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "admin:role": "node scripts/admin-role.js",
    "test:user": "node scripts/test-user.js",
    "test": "node --test --test-concurrency=1 test/auth.test.js test/security.test.js test/migrations.test.js test/catalog.test.js test/cartWishlist.test.js test/orders.test.js test/dialect.test.js",
    "test:pg": "node --test --env-file=test/pg-smoke.env test/pgSmoke.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^10.1.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.1"
  }
}
