{
  "name": "buyo-backend",
  "version": "1.0.0",
  "description": "Backend API for BuyO e-commerce project",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:sync": "node scripts/db-sync.js",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "node scripts/db-backup.js",
    "db:restore": "node scripts/db-restore.js",
    "admin:role": "node scripts/admin-role.js",
    "migrate:data": "node scripts/migrate-data.js",
    "migrate:storage": "node scripts/storage-migrate.js",
    "test:user": "node scripts/test-user.js",
    "test": "node --test --test-concurrency=1 test/auth.test.js test/security.test.js test/migrations.test.js test/catalog.test.js test/cartWishlist.test.js test/orders.test.js test/adminReadModels.test.js test/dialect.test.js test/frontendConfig.test.js test/adminUploadFlow.test.js test/storageAdapter.test.js test/storageUpload.test.js test/storageMigrate.test.js test/deployReadiness.test.js test/pgRuntime.test.js test/health.test.js test/remoteMigrationGate.test.js test/remoteGateCli.test.js",
    "test:pg": "node --test --env-file=test/pg-smoke.env test/pgSmoke.test.js",
    "test:pg:catalog": "node test/pgSuite.js test/catalog.test.js",
    "test:pg:orders": "node test/pgSuite.js test/orders.test.js",
    "test:pg:auth": "node test/pgSuite.js test/auth.test.js",
    "test:pg:cart": "node test/pgSuite.js test/cartWishlist.test.js",
    "test:pg:security": "node test/pgSuite.js test/security.test.js",
    "test:pg:migrations": "node test/pgSuite.js test/pgMigrations.test.js",
    "test:pg:base": "node test/pgSuite.js test/pgBaseSchema.test.js",
    "test:pg:tooling": "node test/pgSuite.js test/pgTooling.test.js",
    "test:pg:data": "node test/pgSuite.js test/dataMigration.test.js",
    "test:pg:storage": "node test/pgSuite.js test/storageUpload.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.9.7",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
